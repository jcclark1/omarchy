# Server packages installed conditionally by install/hardware/ scripts rather
# than pacstrapped. The ISO builder adds them to the headless offline mirror so
# those scripts can install them without a network (the server counterpart of
# omarchy-other.packages).

# NVIDIA compute driver, both branches (install/hardware/nvidia.sh, server branch)
nvidia-open-dkms
nvidia-utils
nvidia-580xx-dkms
nvidia-580xx-utils

# GPU compute and video acceleration (install/hardware/vulkan.sh,
# intel/video-acceleration.sh)
vulkan-intel
vulkan-radeon
intel-media-driver
libvpl
vpl-gpu-rt
libva-intel-driver

# Bluetooth, only when an adapter is present (install/hardware/bluetooth.sh)
bluez
bluez-utils

# Intel power/thermal daemons for a laptop run as a server
# (install/hardware/intel/thermald.sh, lpmd.sh; both battery-gated)
thermald
intel-lpmd
